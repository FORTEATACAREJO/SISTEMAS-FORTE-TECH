{
  "schema": "forte-atende-plugin/v1",
  "id": "microsoft365",
  "name": "Outlook e Microsoft 365",
  "version": "0.1.0",
  "provider": "microsoft-graph",
  "channel": "email",
  "authentication": "oauth2",
  "requested_permissions": [
    "Mail.Read",
    "Mail.Send"
  ],
  "capabilities": [
    "receive",
    "reply",
    "send"
  ],
  "status": "adapter_implemented",
  "credentials_policy": "vault_only",
  "enabled_by_default": false,
  "real_account_connected": false,
  "require_provider_verification": true,
  "tenant_isolation": true,
  "notes": "Codigo-fonte de integracao disponivel. Requer credenciais e configuracao OAuth/Meta/TLS no backend para conectar uma conta real."
}
